# ============================================================================
# Sloppy — Environment Variables
# ============================================================================
# Copy to .env and fill in values. Variables marked [LOCAL] are only needed
# for local development. Variables marked [PROD] are handled via Secret
# Manager in production and should never be committed.
#
# For docker-compose, this file is auto-loaded from the project root.
# ============================================================================

# ── GCP / Firebase ──────────────────────────────────────────────────────────

# [PROD] GCP project ID
GCP_PROJECT_ID=your-gcp-project-id

# [PROD] Custom domain for the frontend (used by deploy.sh for CORS + Firebase Auth)
CUSTOM_DOMAIN=sloppygames.io

# [LOCAL] Path to Firebase service account key JSON
# In production, mount via Secret Manager — never commit this file.
# Place the JSON file at ./secrets/firebase-sa.json for docker-compose.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json

# [LOCAL] Alternatively, provide the service account JSON inline (useful in CI)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firebase project ID (used by api-gateway and auth)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Database ────────────────────────────────────────────────────────────────

# [LOCAL] Local PostgreSQL connection string (docker-compose provides this)
DATABASE_URL=postgresql://sloppy:sloppy_dev@localhost:5432/sloppy

# [PROD] Set via Secret Manager — TF_VAR_db_password
# DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────

# [LOCAL] Local Redis URL (docker-compose provides this)
REDIS_URL=redis://localhost:6379

# ── API Gateway ─────────────────────────────────────────────────────────────

# CORS allowed origin (localhost:8080 for docker-compose, localhost:5173 for pnpm dev)
CORS_ORIGIN=http://localhost:5173

# Downstream service URLs (docker-compose overrides these with container names)
AUTH_SERVICE_URL=http://localhost:3002
GAME_BUILDER_URL=http://localhost:3003
AI_ORCHESTRATOR_URL=http://localhost:3004
MULTIPLAYER_URL=http://localhost:3005

# ── LLM / AI ───────────────────────────────────────────────────────────────

# Provider: "openai", "anthropic", or "grok"
LLM_PROVIDER=openai

# [PROD] Set via Secret Manager — never commit
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# [PROD] Set via Secret Manager — never commit
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# [PROD] Set via Secret Manager — never commit
GROK_API_KEY=xai-your-grok-key-here
GROK_MODEL=grok-3

# ── Google Cloud Storage ────────────────────────────────────────────────────

GCS_BUCKET=sloppy-game-bundles-dev
CDN_BASE_URL=https://storage.googleapis.com/sloppy-game-bundles-dev

# ── Frontend (Vite) ────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_CDN_URL=
VITE_SENTRY_DSN=

# ── Observability ──────────────────────────────────────────────────────────

LOG_LEVEL=debug
SENTRY_DSN=

# ── Rate Limits (api-gateway) ──────────────────────────────────────────────

RATE_LIMIT_GENERAL_AUTH_RPM=100
RATE_LIMIT_GENERAL_UNAUTH_RPM=30
RATE_LIMIT_GENERATION_PER_HOUR=5

# ── AI Generation Limits ───────────────────────────────────────────────────

GENERATION_TIMEOUT_MS=120000
MAX_TOKENS_CONCEPT=2000
MAX_TOKENS_CODE=8000
MAX_TOKENS_ASSETS=2000
MAX_TOKENS_MULTIPLAYER=4000
DAILY_COST_THRESHOLD=50

# ── Game Builder ────────────────────────────────────────────────────────────

MAX_BUNDLE_SIZE_BYTES=5242880
PLAY_DEBOUNCE_WINDOW_SECONDS=300

# ── Multiplayer ─────────────────────────────────────────────────────────────

MAX_CONCURRENT_SESSIONS=100
MAX_PLAYERS_PER_SESSION=4
TICK_RATE=20
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=10000
CLEANUP_INTERVAL=300000
EMPTY_ROOM_TIMEOUT=60000
REDIS_KEY_TTL=3600
