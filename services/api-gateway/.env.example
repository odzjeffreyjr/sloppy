# Server
PORT=3001

# CORS — allowed origin for the web client
CORS_ORIGIN=http://localhost:5173

# Downstream service URLs
AUTH_SERVICE_URL=http://localhost:3002
GAME_BUILDER_URL=http://localhost:3003
AI_ORCHESTRATOR_URL=http://localhost:3004
MULTIPLAYER_URL=http://localhost:3005

# Redis (used for rate-limit state)
REDIS_URL=redis://localhost:6379

# Rate limits
RATE_LIMIT_GENERAL_AUTH_RPM=100       # per-user (authenticated), per minute
RATE_LIMIT_GENERAL_UNAUTH_RPM=30      # per-IP (unauthenticated), per minute
RATE_LIMIT_GENERATION_PER_HOUR=5      # game generations per user per hour

# Firebase Admin SDK (required for auth-middleware)
GOOGLE_APPLICATION_CREDENTIALS=        # path to service account key JSON
FIREBASE_PROJECT_ID=

# Observability
LOG_LEVEL=info                         # debug | info | warn | error
SENTRY_DSN=                            # Sentry DSN for error tracking (optional)
