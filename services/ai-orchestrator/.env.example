# Service
PORT=3004

# Redis
REDIS_URL=redis://localhost:6379

# LLM Provider: "openai", "anthropic", or "grok"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Grok (xAI)
GROK_API_KEY=xai-your-grok-key-here
GROK_MODEL=grok-3

# Generation limits
GENERATION_TIMEOUT_MS=120000
MAX_TOKENS_CONCEPT=2000
MAX_TOKENS_CODE=8000
MAX_TOKENS_ASSETS=2000
MAX_TOKENS_MULTIPLAYER=4000

# Database (for generation cost tracking)
DATABASE_URL=postgresql://user:password@localhost:5432/sloppy

# Cost tracking
DAILY_COST_THRESHOLD=50                # alert when daily AI cost exceeds this (USD)

# Observability
LOG_LEVEL=info                         # debug | info | warn | error
SENTRY_DSN=                            # Sentry DSN for error tracking (optional)
