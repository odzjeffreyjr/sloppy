# Server
PORT=3003

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sloppy

# Redis (used for play count debouncing)
REDIS_URL=redis://localhost:6379

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_BUCKET=sloppy-game-bundles

# CDN base URL for serving game bundles (defaults to GCS public URL)
CDN_BASE_URL=https://storage.googleapis.com/sloppy-game-bundles

# Validation
MAX_BUNDLE_SIZE_BYTES=5242880
RUNTIME_VALIDATION_TIMEOUT_MS=30000

# Puppeteer (optional — set for Docker or custom Chromium binary)
PUPPETEER_EXECUTABLE_PATH=

# Play count debounce window (seconds) — max 1 play per user per game per window
PLAY_DEBOUNCE_WINDOW_SECONDS=300

# Thumbnail Generation (fal.ai FLUX)
FAL_KEY=                                # fal.ai API key for FLUX image generation

# Observability
LOG_LEVEL=info                         # debug | info | warn | error
SENTRY_DSN=                            # Sentry DSN for error tracking (optional)
