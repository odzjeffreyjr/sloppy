# Server
PORT=3002

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/sloppy

# Firebase — provide ONE of the following:

# Option 1: Path to a service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 2: Service account JSON as an inline string (useful in containers / CI)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Observability
LOG_LEVEL=info                         # debug | info | warn | error
SENTRY_DSN=                            # Sentry DSN for error tracking (optional)
