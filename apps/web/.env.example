# API
VITE_API_URL=http://localhost:3001

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# CDN (for game bundles)
VITE_CDN_URL=

# Ads
VITE_AD_PROVIDER=placeholder           # placeholder | adinplay | adsense
VITE_ADSENSE_CLIENT_ID=                # Google AdSense client ID (ca-pub-XXXXX)
VITE_ADSENSE_SLOT_ID=                  # Fallback slot ID for all formats
VITE_ADSENSE_SLOT_LEADERBOARD=         # 728x90 slot ID (optional, overrides fallback)
VITE_ADSENSE_SLOT_RECTANGLE=           # 300x250 slot ID (optional, overrides fallback)
VITE_ADSENSE_SLOT_MOBILE=              # 320x50 slot ID (optional, overrides fallback)
VITE_ADSENSE_SLOT_INTERSTITIAL=        # 320x480 slot ID (optional, overrides fallback)
VITE_ADSENSE_SLOT_REWARDED=            # Rewarded video slot ID (optional, overrides fallback)

# Observability
VITE_SENTRY_DSN=                       # Sentry DSN for frontend error tracking (optional)
