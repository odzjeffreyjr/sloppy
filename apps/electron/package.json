{
  "name": "@sloppy/electron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -n web,electron \"pnpm --filter @sloppy/web dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -p tsconfig.json",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:win": "pnpm build && electron-builder --win",
    "build:linux": "pnpm build && electron-builder --linux",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "wait-on": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
